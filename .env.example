# Scientific Literature GraphRAG — environment template.
# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# All variables use the SGRAG_ prefix so they cannot collide with other projects.

# --- Neo4j ---
SGRAG_NEO4J_URI=bolt://localhost:7687
SGRAG_NEO4J_USER=neo4j
SGRAG_NEO4J_PASSWORD=change-me
SGRAG_NEO4J_DATABASE=neo4j

# --- LLM (provider-agnostic: groq | openai | ollama) ---
SGRAG_LLM_PROVIDER=groq
SGRAG_LLM_MODEL=openai/gpt-oss-120b
# Use a FRESH key for this project — do not reuse keys from other projects.
SGRAG_LLM_API_KEY=
SGRAG_LLM_BASE_URL=
SGRAG_LLM_TIMEOUT_S=120

# --- Hugging Face (optional; for gated datasets) ---
SGRAG_HF_TOKEN=

# --- Paths / runtime ---
SGRAG_DATA_DIR=data
SGRAG_RESULTS_DIR=results
SGRAG_LOG_LEVEL=INFO

# --- Retrieval defaults (overridable per experiment YAML) ---
SGRAG_TOP_K=5
SGRAG_RERANK_POOL_SIZE=50
